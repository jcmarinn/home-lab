# =============================================================================
# Environment Variables — copy this file to .env and fill in your values
# .env is excluded from git via .gitignore
# =============================================================================

# User and group ID for file permission consistency across containers.
# Run `id` in your terminal to find your values.
PUID=1000
PGID=1000

# Your local timezone. See https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# Absolute path to your home directory (or wherever you store docker config folders).
# Volume mounts follow the pattern: ${USERDIR}/docker/<service>/...
USERDIR=/home/youruser
